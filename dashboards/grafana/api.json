   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Database-unavailable responses",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "increase(api_db_errors_total[$__rate_interval]) or vector(0)",
     "legendFormat": "db errors",
     "range": true,
     "instant": false
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
