{
  "type": "record",
  "name": "TripEvent",
  "namespace": "com.mobility.events",
  "doc": "Unified taxi trip event (yellow + green). event_time = pickup time. Timestamps are wall-clock values as published by TLC (NYC local time) stored as-is, not converted.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "Deterministic uuid5(taxi_type|source_file|source_row): replaying the same file yields the same ids, so downstream dedup is testable."},
    {"name": "taxi_type", "type": "string", "doc": "yellow | green"},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Pickup timestamp; the event-time axis for windows/watermarks."},
    {"name": "ingestion_time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Producer wall-clock when the event was emitted."},
    {"name": "source_file", "type": "string"},
    {"name": "source_row", "type": "long"},
    {"name": "vendor_id", "type": ["null", "int"], "default": null},
    {"name": "pickup_ts", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "dropoff_ts", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
    {"name": "passenger_count", "type": ["null", "int"], "default": null},
    {"name": "trip_distance", "type": ["null", "double"], "default": null},
    {"name": "ratecode_id", "type": ["null", "int"], "default": null},
    {"name": "store_and_fwd_flag", "type": ["null", "string"], "default": null},
    {"name": "pu_location_id", "type": ["null", "int"], "default": null},
    {"name": "do_location_id", "type": ["null", "int"], "default": null},
    {"name": "payment_type", "type": ["null", "int"], "default": null},
    {"name": "fare_amount", "type": ["null", "double"], "default": null},
    {"name": "extra", "type": ["null", "double"], "default": null},
    {"name": "mta_tax", "type": ["null", "double"], "default": null},
    {"name": "tip_amount", "type": ["null", "double"], "default": null},
    {"name": "tolls_amount", "type": ["null", "double"], "default": null},
    {"name": "improvement_surcharge", "type": ["null", "double"], "default": null},
    {"name": "total_amount", "type": ["null", "double"], "default": null},
    {"name": "congestion_surcharge", "type": ["null", "double"], "default": null},
    {"name": "airport_fee", "type": ["null", "double"], "default": null},
    {"name": "trip_type", "type": ["null", "int"], "default": null, "doc": "green only"},
    {"name": "ehail_fee", "type": ["null", "double"], "default": null, "doc": "green only"}
  ]
}
